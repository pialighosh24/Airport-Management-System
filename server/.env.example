# ===================================================
# AeroNexus Server - Environment Configuration
# ===================================================
# Copy this file to .env and configure your values.
# NEVER commit the real .env file or credentials to Git.

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Allowed Client Origins for CORS (Comma-separated for local Expo development)
CLIENT_ORIGIN=http://localhost:8081,http://localhost:8082,http://localhost:19006

# ===================================================
# Database Connection (MySQL 8.0)
# ===================================================
# Connection settings for your local or remote MySQL 8.0 instance.
# NOTE: If DB credentials are not configured or the server is unreachable,
# AeroNexus seamlessly falls back to Standalone Demo Mode without crashing.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=aeronexus
DB_CONNECTION_LIMIT=10

# Flight Telemetry API (e.g. AviationStack, OpenSky, FlightRadar)
FLIGHT_DATA_API_KEY=your_flight_api_key_here
FLIGHT_DATA_API_BASE_URL=https://api.example.com/v1

# OpenSky Network API (Optional: Leave empty for free anonymous public access)
# Anonymous access allows 1 request every 10s (cached on backend).
# If you have a free registered OpenSky account, you can add credentials below for higher rate limits:
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Flight Fare Comparison API
FLIGHT_FARE_API_KEY=your_flight_fare_api_key_here

# Amadeus Flight Offers API (https://test.api.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# FlightAware AeroAPI (https://aeroapi.flightaware.com)
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# Email Notification Service (e.g. Resend, SendGrid)
EMAIL_SERVICE_API_KEY=your_email_service_api_key_here
EMAIL_FROM_ADDRESS=alerts@aeronexus.aero
