# ===================================================
# AeroNexus Server - Environment Configuration
# ===================================================
# Copy this file to .env and configure your values.
# NEVER commit the real .env file or credentials to Git.

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Allowed Client Origins for CORS (Comma-separated for local Expo development)
CLIENT_ORIGIN=http://localhost:8081,http://localhost:8082,http://localhost:19006

# ===================================================
# Database Connection (PostgreSQL / MySQL)
# ===================================================
# NOTE: If DB credentials are not configured or unreachable,
# AeroNexus seamlessly falls back to Standalone Demo Mode without crashing.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeronexus
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=aeronexus

# ===================================================
# Redis & BullMQ (Background Jobs & Pub/Sub)
# ===================================================
REDIS_URL=redis://localhost:6379

# ===================================================
# Provider 1: OpenSky Network (Live Aircraft ADS-B Telemetry)
# ===================================================
# Public anonymous access is 100% FREE (rate-limited to 1 request / 10s).
# If you have a free registered account at https://opensky-network.org, add credentials below:
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ===================================================
# Provider 2: FlightAware AeroAPI (Flight Status & Schedules)
# ===================================================
# Sign up at: https://www.flightaware.com/commercial/aeroapi/
# If unconfigured, AeroNexus falls back to curated airport schedule models.
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# ===================================================
# Provider 3: Amadeus for Developers (Live Flight Fares)
# ===================================================
# Free self-service test tier at: https://developers.amadeus.com/my-apps
# If unconfigured, AeroNexus falls back to transparent unbundled demo fares.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ===================================================
# Provider 4: Open-Meteo (Airport Meteorological Context)
# ===================================================
# 100% FREE open-source weather API (No API key required).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ===================================================
# Provider 5: Google Maps Platform (Mobile Map Visualization)
# ===================================================
# Sign up at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# ===================================================
# Email Notification Service (Resend / SendGrid / SMTP)
# ===================================================
EMAIL_SERVICE_API_KEY=
EMAIL_FROM_ADDRESS=alerts@aeronexus.aero
