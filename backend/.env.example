# AeroNexus Backend Environment Variables
NODE_ENV=development
PORT=5000

# Client Origins for CORS (comma-separated)
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8082

# Database Connection (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aeronexus
DB_CONNECTION_LIMIT=10

# JWT Authentication Secret
JWT_SECRET=aeronexus_super_secure_jwt_token_secret_key_2026
JWT_EXPIRES_IN=7d

# OpenSky Network ADS-B Telemetry (Optional Basic Auth)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
