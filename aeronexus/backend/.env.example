# Leave MONGODB_URI empty to start an in-memory MongoDB replica set (dev only, data resets on restart).
MONGODB_URI=
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Use a long random string in any shared environment.
JWT_SECRET=change-me-dev-only
# demo = simulated flights/aircraft/fares, all labelled DEMO.
# live = real OpenSky aircraft positions on the map. Weather (Open-Meteo) is always live.
PROVIDER_MODE=demo
OPENSKY_POLL_SEC=300
FRESHNESS_LIVE_SEC=60
FRESHNESS_STALE_SEC=600
MATCH_CONFIDENCE_MIN=0.8
# Optional: creates an admin account on boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
